# TinyFish API key. Keep this secret and never commit your real .env file.
TINYFISH_API_KEY=
# Anthropic API key used to classify privacy-policy statements.
ANTHROPIC_API_KEY=
# Claude model identifier; confirm availability in your Anthropic account.
CLAUDE_MODEL=claude-sonnet-5-5
# Maximum concurrent vendor investigations.
MAX_WORKERS=4
# Set to 1 only if you explicitly allow the metered TinyFish Agent fallback.
ALLOW_AGENT_FALLBACK=0
